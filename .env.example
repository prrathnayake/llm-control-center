# Server
LLM_CC_ENV=dev
LLM_CC_ADMIN_TOKEN=change-me-admin-token
LLM_CC_API_KEY_PEPPER=change-me-long-random-pepper
LLM_CC_DATABASE_URL=sqlite:///./data/control_center.sqlite3
LLM_CC_USAGE_SPOOL_PATH=./data/usage_spool.sqlite3
# For PostgreSQL: LLM_CC_DATABASE_URL=postgresql+psycopg2://llm_cc:changeme@localhost:5432/llm_control_center

# Routing aliases exposed to your projects. Provider model names stay inside the gateway.
LLM_CC_MODEL_ROUTES={"default-chat":{"provider":"mock","provider_model":"mock-smart"},"local-chat":{"provider":"ollama","provider_model":"llama3.1"},"cloud-chat":{"provider":"openai_compatible","provider_model":"gpt-4o-mini","api":"responses"}}
LLM_CC_DEFAULT_MODEL_ALIAS=default-chat

# OpenAI-compatible provider: OpenAI, OpenRouter, Groq, Together, LM Studio, vLLM, etc.
LLM_CC_OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com
LLM_CC_OPENAI_COMPATIBLE_API_KEY=
LLM_CC_OPENAI_COMPATIBLE_RESPONSES_API=true
LLM_CC_REQUEST_TIMEOUT_SECONDS=60

# Provider bulkhead and circuit breaker
LLM_CC_PROVIDER_MAX_CONCURRENCY=32
LLM_CC_PROVIDER_QUEUE_TIMEOUT_SECONDS=5
LLM_CC_PROVIDER_FAILURE_THRESHOLD=5
LLM_CC_PROVIDER_CIRCUIT_COOLDOWN_SECONDS=30

# Local provider
LLM_CC_OLLAMA_BASE_URL=http://localhost:11434

# CORS (comma-separated origins; default allows localhost:3000 and localhost:8080)
LLM_CC_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Protect /docs, /redoc, /openapi.json behind X-Admin-Token header
LLM_CC_DOCS_PROTECTED=true

# Enable only when the gateway is behind a proxy that strips client-supplied forwarding headers.
LLM_CC_TRUST_PROXY_HEADERS=false
